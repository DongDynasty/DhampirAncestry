    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Common">
      <HintPath>G:\Steam\steamapps\common\Dawnsbury Days\Data\Common.dll</HintPath>
    </Reference>
    <Reference Include="Dawnsbury Days">
      <HintPath>G:\Steam\steamapps\common\Dawnsbury Days\Data\Dawnsbury Days.dll</HintPath>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>G:\Steam\steamapps\common\Dawnsbury Days\Data\MonoGame.Framework.dll</HintPath>
    </Reference>
	<Reference Include="0Harmony">
		<HintPath>G:\Steam\steamapps\common\Dawnsbury Days\Data\0Harmony.dll</HintPath>
		<Private>false</Private>
	</Reference>
  </ItemGroup>

<Target Name="CopyToGameModsFolder" AfterTargets="Build">
	<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Dawnsbury)/CustomMods" />
</Target>

</Project>